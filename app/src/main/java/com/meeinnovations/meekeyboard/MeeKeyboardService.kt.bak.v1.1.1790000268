    // ─── Lifecycle ─────────────────────────────────────────
    override fun onStartInput(attribute: EditorInfo?, restarting: Boolean) {
        super.onStartInput(attribute, restarting)
        loadAllPrefs()
        registerClipListener()
    }

    override fun onStartInputView(info: EditorInfo?, restarting: Boolean) {
        super.onStartInputView(info, restarting)
        updateEnterLabel(info)
        if (activePanel == null) showKeys()
    }

    override fun onFinishInput() {
        super.onFinishInput()
        unregisterClipListener()
    }

    override fun onDestroy() {
        stopBackspaceRepeat()
        unregisterClipListener()
        super.onDestroy()
    }

    private fun loadAllPrefs() {
        try {
            language = prefs.getString("lang", "en") ?: "en"
            theme = prefs.getString("theme", "dark") ?: "dark"
            background = prefs.getString("background", "none") ?: "none"
            soundOn = prefs.getBoolean("sound_on", true)
            val raw = prefs.getString("user_dict", "") ?: ""
            if (raw.isNotEmpty()) {
                userDict.clear()
                raw.split("|").forEach { entry ->
                    val p = entry.split(":")
                    if (p.size == 2) {
                        val w = p[0]
                        val c = p[1].toIntOrNull() ?: 1
                        if (w.isNotEmpty()) userDict[w] = c
                    }
                }
            }
            val rec = prefs.getString("clip_recent", "") ?: ""
            if (rec.isNotEmpty()) {
                clipRecent.clear()
                clipRecent.addAll(rec.split("\u0001").filter { it.isNotEmpty() })
            }
            val pin = prefs.getString("clip_pinned", "") ?: ""
            if (pin.isNotEmpty()) {
                clipPinned.clear()
                clipPinned.addAll(pin.split("\u0001").filter { it.isNotEmpty() })
            }
        } catch (_: Throwable) {}
    }

    private fun loadDictionaryIfNeeded() {
        if (EN_WORDS == null) {
            EN_WORDS = try {
                assets.open("en_words.txt").bufferedReader()
                    .useLines { it.map { ln -> ln.trim() }.filter { it.isNotEmpty() }.toList() }
            } catch (_: Throwable) { emptyList() }
        }
        if (BN_WORDS == null) {
            BN_WORDS = try {
                assets.open("bn_words.txt").bufferedReader()
                    .useLines { it.map { ln -> ln.trim() }.filter { it.isNotEmpty() }.toList() }
            } catch (_: Throwable) { emptyList() }
        }
    }

    // ─── Root view ─────────────────────────────────────────
    override fun onCreateInputView(): View {
        loadDictionaryIfNeeded()
        val root = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            applyBackground(this)
            setPadding(dpToPx(2), dpToPx(2), dpToPx(2), dpToPx(3))
        }
        root.addView(buildToolbar())

        contentContainer = SwipeLinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            swipeThresholdPx = dpToPx(60).toFloat()
            onSwipe = { path -> processSwipePath(path) }
        }
        root.addView(contentContainer)

        showKeys()
        return root
    }

    private fun buildToolbar(): View {
        val bar = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            setBackgroundColor(bgToolbar)
            setPadding(dpToPx(4), dpToPx(4), dpToPx(4), dpToPx(4))
        }
        bar.addView(toolbarButton(R.drawable.ic_emoji, "emoji"))
        bar.addView(toolbarButton(R.drawable.ic_clipboard, "clipboard"))
        bar.addView(toolbarButton(R.drawable.ic_keyboard, "keys"))
        bar.addView(toolbarButton(R.drawable.ic_globe, "lang"))
        bar.addView(toolbarButton(R.drawable.ic_theme, "theme"))
        bar.addView(toolbarButton(R.drawable.ic_settings, "settings"))
        bar.addView(View(this).apply {
            layoutParams = LinearLayout.LayoutParams(0, 1, 1f)
        })
        bar.addView(toolbarButton(R.drawable.ic_collapse, "collapse"))
        return bar
    }

    private fun toolbarButton(iconRes: Int, action: String): View =
        ImageView(this).apply {
            setImageResource(iconRes)
            setColorFilter(fgText)
            val size = dpToPx(24)
            val pad = dpToPx(8)
            layoutParams = LinearLayout.LayoutParams(size + pad * 2, size + pad * 2).apply {
                val m = dpToPx(2)
                setMargins(m, m, m, m)
            }
            setPadding(pad, pad, pad, pad)
            setOnClickListener { v ->
                haptic(v)
                when (action) {
                    "clipboard" -> showClipboardPanel()
                    "emoji" -> showEmojiPanel()
                    "keys" -> showKeys()
                    "lang" -> toggleLang()
                    "theme" -> showThemePanel()
                    "settings" -> showSettingsPanel()
                    "collapse" -> requestHideSelf(0)
                }
            }
        }

    // ─── Keys ──────────────────────────────────────────────
    private fun showKeys() {
        activePanel = null
        contentContainer.removeAllViews()
        if (language == "bn") showBengaliKeys() else showEnglishKeys()
    }

    private fun addSuggestionBar() {
        val bar = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            tag = "suggbar"
            visibility = if (suggestions.isEmpty()) View.GONE else View.VISIBLE
            setPadding(dpToPx(4), dpToPx(2), dpToPx(4), dpToPx(2))
        }
        if (suggestions.isNotEmpty()) {
            suggestions.forEach { bar.addView(suggestionChip(it)) }
        }
        contentContainer.addView(bar)
    }

    private fun showEnglishKeys() {
        letterButtons.clear()
        addSuggestionBar()

        val r1 = row()
        listOf("1","2","3","4","5","6","7","8","9","0").forEach { r1.addView(letterKey(it)) }
        r1.addView(backspaceKey())
        contentContainer.addView(r1)

        val r2 = row()
        listOf("q","w","e","r","t","y","u","i","o","p").forEach { r2.addView(letterKey(it)) }
        contentContainer.addView(r2)

        val r3 = row()
        listOf("a","s","d","f","g","h","j","k","l").forEach { r3.addView(letterKey(it)) }
        r3.addView(specialKey(enterLabel, "Enter", 1.4f))
        contentContainer.addView(r3)

        val r4 = row()
        r4.addView(shiftKey())
        listOf("z","x","c","v","b","n","m",".",",").forEach { r4.addView(letterKey(it)) }
        contentContainer.addView(r4)

        // Bottom row — Gboard standard
        val r5 = row()
        r5.addView(numberToggleKey())     // ?123
        r5.addView(commaKey())            // ,
        r5.addView(spaceKeyWide())        // wide space
        r5.addView(periodKey())           // .
        r5.addView(enterBottomKey())      // ⏎
        contentContainer.addView(r5)

        applyShiftState()
    }

    // ─── Gboard-style bottom row keys ─────────────────────
    private fun numberToggleKey(): Button = Button(this).apply {
        text = "?123"
        textSize = 13f
        setTextColor(fgText)
        setBackgroundResource(keySpecialRes())
        setPadding(0, 0, 0, 0)
        isAllCaps = false
        stateListAnimator = null
        layoutParams = baseParams(1.2f)
        setOnClickListener { v ->
            haptic(v)
            showSymbolPage(1)
        }
    }

    private fun commaKey(): Button = Button(this).apply {
        text = ","
        textSize = 16f
        setTextColor(fgText)
        setBackgroundResource(keySpecialRes())
        setPadding(0, 0, 0, 0)
        stateListAnimator = null
        layoutParams = baseParams(0.8f)
        setOnClickListener { v ->
            haptic(v)
            commit(",")
            refreshSuggestionBar()
        }
        setOnLongClickListener { v ->
            haptic(v)
            commit("!")
            true
        }
    }

    private fun periodKey(): Button = Button(this).apply {
        text = "."
        textSize = 16f
        setTextColor(fgText)
        setBackgroundResource(keySpecialRes())
        setPadding(0, 0, 0, 0)
        stateListAnimator = null
        layoutParams = baseParams(0.8f)
        setOnClickListener { v ->
            haptic(v)
            commit(".")
            refreshSuggestionBar()
        }
        setOnLongClickListener { v ->
            haptic(v)
            commit("?")
            true
        }
    }

    private fun enterBottomKey(): Button = Button(this).apply {
        text = "\u23CE"
        textSize = 16f
        setTextColor(fgText)
        setBackgroundResource(keySpecialRes())
        setPadding(0, 0, 0, 0)
        stateListAnimator = null
        layoutParams = baseParams(1.2f)
        setOnClickListener { v ->
            haptic(v)
            val ic = currentInputConnection
            val a = currentInputEditorInfo?.imeOptions?.and(EditorInfo.IME_MASK_ACTION) ?: 0
            when (a) {
                EditorInfo.IME_ACTION_SEARCH,
                EditorInfo.IME_ACTION_SEND,
                EditorInfo.IME_ACTION_NEXT,
                EditorInfo.IME_ACTION_DONE,
                EditorInfo.IME_ACTION_GO -> ic?.performEditorAction(a)
                else -> ic?.commitText("\n", 1)
            }
        }
    }

    private fun spaceKeyWide(): Button = Button(this).apply {
        text = if (language == "bn") "বাংলা" else "English"
        textSize = 11f
        setTextColor(fgMuted)
        setBackgroundResource(keySpecialRes())
        setPadding(0, 0, 0, 0)
        isAllCaps = false
        stateListAnimator = null
        layoutParams = baseParams(5.5f)
        setOnClickListener { v ->
            haptic(v)
            commitSpace()
        }
        setOnLongClickListener { v ->
            haptic(v)
            toggleLang()
            true
        }
    }

    private fun showSymbolPage(page: Int) {
        activePanel = "symbols"
        contentContainer.removeAllViews()

        if (page == 1) {
            // Numbers + common symbols
            val r1 = row()
            listOf("1","2","3","4","5","6","7","8","9","0").forEach { r1.addView(symbolKey(it)) }
            contentContainer.addView(r1)

            val r2 = row()
            listOf("@","#","$","%","&","-","+","(",")","/").forEach { r2.addView(symbolKey(it)) }
            contentContainer.addView(r2)

            val r3 = row()
            listOf("*","\"","'",":",";","!","?").forEach { r3.addView(symbolKey(it)) }
            r3.addView(backspaceKey())
            contentContainer.addView(r3)

            val r4 = row()
            r4.addView(symbolPageToggleKey("2/2", 2))
            r4.addView(symbolKey("<"))
            r4.addView(symbolKey(">"))
            r4.addView(symbolKey("["))
            r4.addView(symbolKey("]"))
            r4.addView(symbolKey("{"))
            r4.addView(symbolKey("}"))
            r4.addView(symbolKey("="))
            contentContainer.addView(r4)

            val r5 = row()
            r5.addView(letterPageToggleKey())
            r5.addView(symbolKey(","))
            r5.addView(spaceKeyWide())
            r5.addView(symbolKey("."))
            r5.addView(enterBottomKey())
            contentContainer.addView(r5)
        } else {
            // Page 2/2 — more symbols
            val r1 = row()
            listOf("~","`","|","•","√","π","÷","×","§","∆").forEach { r1.addView(symbolKey(it)) }
            contentContainer.addView(r1)

            val r2 = row()
            listOf("£","¢","€","¥","^","°","=","{","}","\\").forEach { r2.addView(symbolKey(it)) }
            contentContainer.addView(r2)

            val r3 = row()
            listOf("©","®","™","✓","™","…","¿","¡").forEach { r3.addView(symbolKey(it)) }
            r3.addView(backspaceKey())
            contentContainer.addView(r3)

            val r4 = row()
            r4.addView(symbolPageToggleKey("1/2", 1))
            r4.addView(symbolKey("+"))
            r4.addView(symbolKey("="))
            r4.addView(symbolKey("×"))
            r4.addView(symbolKey("÷"))
            r4.addView(symbolKey("%"))
            r4.addView(symbolKey("^"))
            r4.addView(symbolKey("\u221A"))
            contentContainer.addView(r4)

            val r5 = row()
            r5.addView(letterPageToggleKey())
            r5.addView(symbolKey(","))
            r5.addView(spaceKeyWide())
            r5.addView(symbolKey("."))
            r5.addView(enterBottomKey())
            contentContainer.addView(r5)
        }
    }

    private fun symbolPageToggleKey(label: String, targetPage: Int): Button = Button(this).apply {
        text = label
        textSize = 13f
        setTextColor(fgText)
        setBackgroundResource(keySpecialRes())
        setPadding(0, 0, 0, 0)
        isAllCaps = false
        stateListAnimator = null
        layoutParams = baseParams(1.4f)
        setOnClickListener { v ->
            haptic(v)
            showSymbolPage(targetPage)
        }
    }

    private fun letterPageToggleKey(): Button = Button(this).apply {
        text = "ABC"
        textSize = 13f
        setTextColor(fgText)
        setBackgroundResource(keySpecialRes())
        setPadding(0, 0, 0, 0)
        isAllCaps = false
        stateListAnimator = null
        layoutParams = baseParams(1.4f)
        setOnClickListener { v ->
            haptic(v)
            showKeys()
        }
    }

    private fun showBengaliKeys() {
        addSuggestionBar()

        val r1 = row()
        listOf("\u09E7","\u09E8","\u09E9","\u09EA","\u09EB","\u09EC","\u09ED","\u09EE","\u09EF","\u09E6").forEach { r1.addView(bnKey(it)) }
        r1.addView(backspaceKey())
        contentContainer.addView(r1)

        val r2 = row()
        BN_ROW1.forEach { r2.addView(bnKey(it)) }
        contentContainer.addView(r2)

        val r3 = row()
        BN_ROW2.forEach { r3.addView(bnKey(it)) }
        contentContainer.addView(r3)

        val r4 = row()
        BN_ROW3.forEach { r4.addView(bnKey(it)) }
        contentContainer.addView(r4)

        val r5 = row()
        BN_ROW4.forEach { r5.addView(bnKey(it)) }
        r5.addView(specialKey(enterLabel, "Enter", 1.4f))
        contentContainer.addView(r5)

        val r6 = row()
        BN_ROW5.forEach { r6.addView(bnKey(it)) }
        contentContainer.addView(r6)

        val r7 = row()
        r7.addView(cursorKey(-1))
        r7.addView(langKey())
        r7.addView(bnSymbolKey("\u0964"))
        r7.addView(bnSymbolKey("\u09F3"))
        r7.addView(bnSymbolKey("\u09CD"))
        r7.addView(spaceKey())
        r7.addView(cursorKey(1))
        contentContainer.addView(r7)
    }

    private fun letterKey(label: String): Button = Button(this).apply {
        text = label
        textSize = 14f
        setTextColor(fgText)
        setBackgroundResource(keyBgRes())
        setPadding(0, 0, 0, 0)
        isAllCaps = false
        stateListAnimator = null
        layoutParams = baseParams(1f)
        setOnClickListener { v ->
            haptic(v)
            val out = if (shiftOn || shiftLocked) label.uppercase() else label
            commit(out)
            consumeShift()
            refreshSuggestionBar()
        }
        setOnLongClickListener { v ->
            val alt = ALT_MAP[label.lowercase()]
            if (alt != null) {
                haptic(v)
                commit(alt)
                consumeShift()
                true
            } else false
        }
        letterButtons.add(this)
    }

    private fun symbolKey(label: String): Button = Button(this).apply {
        text = label
        textSize = 14f
        setTextColor(fgBrand)
        setBackgroundResource(keySymbolRes())
        setPadding(0, 0, 0, 0)
        stateListAnimator = null
        layoutParams = baseParams(1f)
        setOnClickListener { v ->
            haptic(v)
            commit(label)
        }
    }

    private fun bnKey(label: String): Button = Button(this).apply {
        text = label
        textSize = 16f
        setTextColor(fgText)
        setBackgroundResource(keyBgRes())
        setPadding(0, 0, 0, 0)
        isAllCaps = false
        stateListAnimator = null
        layoutParams = baseParams(1f)
        setOnClickListener { v ->
            haptic(v)
            commit(label)
            refreshSuggestionBar()
        }
    }

    private fun bnSymbolKey(label: String): Button = Button(this).apply {
        text = label
        textSize = 16f
        setTextColor(fgBrand)
        setBackgroundResource(keySymbolRes())
        setPadding(0, 0, 0, 0)
        stateListAnimator = null
        layoutParams = baseParams(1f)
        setOnClickListener { v ->
            haptic(v)
            commit(label)
            if (label == "\u0964") {
                learnCurrentBengaliWord()
                checkBengaliAutoCorrect()
                suggestions = emptyList()
                rebuildSuggestionBar()
            }
        }
    }

    private fun specialKey(label: String, action: String, weight: Float = 1f): Button = Button(this).apply {
        text = label
        textSize = 14f
        setTextColor(fgText)
        setBackgroundResource(keySpecialRes())
        setPadding(0, 0, 0, 0)
        stateListAnimator = null
        layoutParams = baseParams(weight)
        setOnClickListener { v ->
            haptic(v)
            if (action == "Enter") {
                val ic = currentInputConnection
                val a = currentInputEditorInfo?.imeOptions?.and(EditorInfo.IME_MASK_ACTION) ?: 0
                when (a) {
                    EditorInfo.IME_ACTION_SEARCH,
                    EditorInfo.IME_ACTION_SEND,
                    EditorInfo.IME_ACTION_NEXT,
                    EditorInfo.IME_ACTION_DONE,
                    EditorInfo.IME_ACTION_GO -> ic?.performEditorAction(a)
                    else -> ic?.commitText("\n", 1)
                }
            }
        }
    }

    private fun backspaceKey(): Button = Button(this).apply {
        text = "\u232B"
        textSize = 14f
        setTextColor(fgText)
        setBackgroundResource(keySpecialRes())
        setPadding(0, 0, 0, 0)
        stateListAnimator = null
        layoutParams = baseParams(1.4f)
        setOnClickListener { v ->
            haptic(v)
            if (!undoAutoCorrectIfRecent()) {
                currentInputConnection?.deleteSurroundingText(1, 0)
            }
            refreshSuggestionBar()
        }
        setOnLongClickListener { v ->
            haptic(v)
            startBackspaceRepeat()
            true
        }
        setOnTouchListener { _, event ->
            if (event.action == android.view.MotionEvent.ACTION_UP ||
                event.action == android.view.MotionEvent.ACTION_CANCEL) {
                stopBackspaceRepeat()
            }
            false
        }
    }

    private fun shiftKey(): Button {
        val isLocked = shiftLocked
        val isOn = shiftOn || shiftLocked
        return Button(this).apply {
            text = if (isLocked) "\u21EA" else "\u21E7"
            textSize = 16f
            setTextColor(fgText)
            setBackgroundResource(if (isOn) keyShiftOnRes() else keySpecialRes())
            setPadding(0, 0, 0, 0)
            isAllCaps = false
            stateListAnimator = null
            layoutParams = baseParams(1.4f)
            setOnClickListener { v -> toggleShift(v) }
        }
    }

    private fun toggleShift(v: View) {
        haptic(v)
        val now = System.currentTimeMillis()
        val dbl = now - lastShiftTap < 350L
        lastShiftTap = now
        when {
            dbl -> { shiftLocked = !shiftLocked; shiftOn = shiftLocked }
            shiftLocked -> { shiftLocked = false; shiftOn = false }
            shiftOn -> { shiftOn = false }
            else -> { shiftOn = true }
        }
        applyShiftState()
    }

    private fun applyShiftState() {
        val upper = shiftOn || shiftLocked
        letterButtons.forEach { btn ->
            val label = btn.text?.toString() ?: return@forEach
            if (label.length == 1 && label[0].isLetter()) {
                btn.text = if (upper) label.uppercase() else label.lowercase()
            }
        }
        for (r in 0 until contentContainer.childCount) {
            val child = contentContainer.getChildAt(r)
            if (child is LinearLayout && child.childCount > 0) {
                val first = child.getChildAt(0)
                if (first is Button && first.text.isEmpty()) {
                    child.removeViewAt(0)
                    child.addView(shiftKey(), 0)
                    break
                }
            }
        }
    }

    private fun consumeShift() {
        if (shiftLocked) return
        if (shiftOn) { shiftOn = false; applyShiftState() }
    }

    private fun cursorKey(direction: Int): Button = Button(this).apply {
        text = if (direction < 0) "\u25C0" else "\u25B6"
        textSize = 11f
        setTextColor(fgMuted)
        setBackgroundResource(keySpecialRes())
        setPadding(0, 0, 0, 0)
        isAllCaps = false
        stateListAnimator = null
        layoutParams = baseParams(0.8f)
        setOnClickListener { v ->
            haptic(v)
            moveCursor(direction)
        }
    }

    private fun langKey(): Button = Button(this).apply {
        text = if (language == "bn") "BN" else "EN"
        textSize = 12f
        setTextColor(fgBrand)
        setBackgroundResource(keySpecialRes())
        setPadding(0, 0, 0, 0)
        isAllCaps = false
        stateListAnimator = null
        layoutParams = baseParams(1f)
        setOnClickListener { v ->
            haptic(v)
            toggleLang()
        }
    }

    private fun spaceKey(): Button = Button(this).apply {
        text = "Space"
        textSize = 12f
        setTextColor(fgText)
        setBackgroundResource(keySpecialRes())
        setPadding(0, 0, 0, 0)
        stateListAnimator = null
        layoutParams = baseParams(4f)
        setOnClickListener { v ->
            haptic(v)
            commitSpace()
        }
    }

    private fun commitSpace() {
        val now = System.currentTimeMillis()
        val dbl = now - lastSpaceTime < 350L
        lastSpaceTime = now
        val ic = currentInputConnection ?: return

        val before = ic.getTextBeforeCursor(40, 0)?.toString() ?: ""
        val trimmed = before.trimEnd()
        val sb = StringBuilder()
        for (i in trimmed.length - 1 downTo 0) {
            val c = trimmed[i]
            if (c.isLetter() || c == '\'') sb.insert(0, c) else break
        }
        val justTyped = sb.toString()
        if (justTyped.length >= 3) learnWord(justTyped)

        if (dbl) {
            val prev = ic.getTextBeforeCursor(1, 0)?.toString() ?: ""
            if (prev == " ") {
                ic.deleteSurroundingText(1, 0)
                ic.commitText(". ", 1)
                suggestions = emptyList()
                rebuildSuggestionBar()
                applyAutoCapitalize()
                return
            }
        }
        ic.commitText(" ", 1)
        if (language == "en") checkEnglishAutoCorrect()
        suggestions = emptyList()
        rebuildSuggestionBar()
        applyAutoCapitalize()
    }

    private fun moveCursor(direction: Int) {
        val ic = currentInputConnection ?: return
        val key = if (direction < 0) android.view.KeyEvent.KEYCODE_DPAD_LEFT
                  else android.view.KeyEvent.KEYCODE_DPAD_RIGHT
        ic.sendKeyEvent(android.view.KeyEvent(android.view.KeyEvent.ACTION_DOWN, key))
        ic.sendKeyEvent(android.view.KeyEvent(android.view.KeyEvent.ACTION_UP, key))
    }

    private fun toggleLang() {
        language = if (language == "en") "bn" else "en"
        try { prefs.edit().putString("lang", language).apply() } catch (_: Throwable) {}
        showKeys()
    }

    // ─── Suggestions ───────────────────────────────────────
    private fun currentWordPrefix(): String {
        val ic = currentInputConnection ?: return ""
        val before = ic.getTextBeforeCursor(20, 0)?.toString() ?: return ""
        val sb = StringBuilder()
        for (i in before.length - 1 downTo 0) {
            val c = before[i]
            val keep = if (language == "bn") isBengaliLetter(c) else c.isLetter()
            if (keep) sb.insert(0, c) else break
        }
        return sb.toString()
    }

    private fun isBengaliLetter(c: Char): Boolean = c.code in 0x0980..0x09FF

    private fun computeSuggestions(prefix: String): List<String> {
        if (prefix.isEmpty()) return emptyList()
        if (language == "bn") return computeBengaliSuggestions(prefix)
        val lower = prefix.lowercase()
        val result = LinkedHashSet<String>()
        userDict.entries
            .filter { it.key.startsWith(lower) && it.key != lower }
            .sortedByDescending { it.value }
            .take(2)
            .forEach { result.add(caseFor(prefix, it.key)) }
        val dict = EN_WORDS ?: return result.toList()
        for (w in dict) {
            if (result.size >= 3) break
            if (w.startsWith(lower) && w != lower && w !in result) result.add(caseFor(prefix, w))
        }
        return result.toList()
    }

    private fun computeBengaliSuggestions(prefix: String): List<String> {
        val result = LinkedHashSet<String>()
        userDict.entries
            .filter { it.key.startsWith(prefix) && it.key != prefix }
            .sortedByDescending { it.value }
            .take(2)
            .forEach { result.add(it.key) }
        val dict = BN_WORDS ?: return result.toList()
        for (w in dict) {
            if (result.size >= 3) break
            if (w.startsWith(prefix) && w != prefix && w !in result) result.add(w)
        }
        return result.toList()
    }

    private fun caseFor(prefix: String, word: String): String =
        if (prefix.isNotEmpty() && prefix[0].isUpperCase()) word.replaceFirstChar { it.uppercase() }
        else word

    private fun refreshSuggestionBar() {
        suggestions = computeSuggestions(currentWordPrefix())
        rebuildSuggestionBar()
    }

    private fun rebuildSuggestionBar() {
        val bar = contentContainer.findViewWithTag<LinearLayout>("suggbar") ?: return
        bar.removeAllViews()
        if (activePanel != null || suggestions.isEmpty()) {
            bar.visibility = View.GONE
            return
        }
        bar.visibility = View.VISIBLE
        suggestions.forEach { bar.addView(suggestionChip(it)) }
    }

    private fun suggestionChip(word: String): View = TextView(this).apply {
        text = word
        textSize = 14f
        setTextColor(fgText)
        setBackgroundResource(keyBgRes())
        setPadding(dpToPx(14), dpToPx(8), dpToPx(14), dpToPx(8))
        layoutParams = LinearLayout.LayoutParams(
            ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT
        ).apply {
            val m = dpToPx(4)
            setMargins(m, m, m, m)
        }
        setOnClickListener { v ->
            haptic(v)
            replaceCurrentWord(word)
        }
    }

    private fun replaceCurrentWord(word: String) {
        val ic = currentInputConnection ?: return
        val prefix = currentWordPrefix()
        if (prefix.isNotEmpty()) ic.deleteSurroundingText(prefix.length, 0)
        ic.commitText("$word ", 1)
        autoCorrectOriginal = null
        suggestions = emptyList()
        rebuildSuggestionBar()
        applyAutoCapitalize()
    }

    // ─── Auto-capitalize ────────────────────────────────────
    private fun shouldAutoCapitalize(): Boolean {
        val ic = currentInputConnection ?: return false
        val before = ic.getTextBeforeCursor(2, 0)?.toString() ?: return true
        if (before.isEmpty()) return true
        if (before.last() in SENTENCE_END) return true
        if (before.isBlank()) return true
        return false
    }

    private fun applyAutoCapitalize() {
        if (shiftLocked) return
        shiftOn = shouldAutoCapitalize()
        applyShiftState()
    }

    // ─── English auto-correct ───────────────────────────────
    private fun checkEnglishAutoCorrect() {
        if (language != "en") return
        val ic = currentInputConnection ?: return
        val dict = EN_WORDS ?: return
        if (dict.isEmpty()) return
        val before = ic.getTextBeforeCursor(40, 0)?.toString() ?: return
        val trimmed = before.trimEnd()
        if (trimmed.isEmpty()) return
        val sb = StringBuilder()
        for (i in trimmed.length - 1 downTo 0) {
            val c = trimmed[i]
            if (c.isLetter() || c == '\'') sb.insert(0, c) else break
        }
        val word = sb.toString()
        if (word.length < 3 || word.length > 20) return
        val lower = word.lowercase()
        val dictSet = dict.toHashSet()
        if (lower in dictSet) return
        if (userDict.containsKey(lower)) return
        val cand = findEnglishEdit1(lower, dictSet) ?: return
        val repl = when {
            word.all { it.isUpperCase() } -> cand.uppercase()
            word[0].isUpperCase() -> cand.replaceFirstChar { it.uppercase() }
            else -> cand
        }
        ic.deleteSurroundingText(word.length, 0)
        ic.commitText(repl, 1)
        autoCorrectOriginal = word
        autoCorrectTime = System.currentTimeMillis()
        autoCorrectLen = repl.length
    }

    private fun findEnglishEdit1(word: String, dictSet: Set<String>): String? {
        val alpha = 'a'..'z'
        for (i in word.indices) {
            for (c in alpha) {
                if (c == word[i]) continue
                val cand = word.substring(0, i) + c + word.substring(i + 1)
                if (cand in dictSet) return cand
            }
        }
        for (i in 0 until word.length - 1) {
            if (word[i] == word[i + 1]) continue
            val cand = word.substring(0, i) + word[i + 1] + word[i] + word.substring(i + 2)
            if (cand in dictSet) return cand
        }
        if (word.length > 3) {
            for (i in word.indices) {
                val cand = word.substring(0, i) + word.substring(i + 1)
                if (cand in dictSet) return cand
            }
        }
        if (word.length in 3..10) {
            for (i in 0..word.length) {
                for (c in alpha) {
                    val cand = word.substring(0, i) + c + word.substring(i)
                    if (cand in dictSet) return cand
                }
            }
        }
        return null
    }

    private fun undoAutoCorrectIfRecent(): Boolean {
        val orig = autoCorrectOriginal ?: return false
        if (System.currentTimeMillis() - autoCorrectTime > 4000L) {
            autoCorrectOriginal = null
            return false
        }
        val ic = currentInputConnection ?: return false
        val before = ic.getTextBeforeCursor(autoCorrectLen, 0)?.toString() ?: return false
        if (before.length != autoCorrectLen) return false
        ic.deleteSurroundingText(autoCorrectLen, 0)
        ic.commitText(orig, 1)
        autoCorrectOriginal = null
        return true
    }

    // ─── Bengali auto-correct ───────────────────────────────
    private fun checkBengaliAutoCorrect() {
        if (language != "bn") return
        val ic = currentInputConnection ?: return
        val dict = BN_WORDS ?: return
        if (dict.isEmpty()) return
        val before = ic.getTextBeforeCursor(40, 0)?.toString() ?: return
        val trimmed = before.trimEnd().trimEnd('\u0964')
        if (trimmed.isEmpty()) return
        val sb = StringBuilder()
        for (i in trimmed.length - 1 downTo 0) {
            val c = trimmed[i]
            if (isBengaliLetter(c)) sb.insert(0, c) else break
        }
        val word = sb.toString()
        if (word.length < 2) return
        val dictSet = dict.toHashSet()
        if (word in dictSet) return
        if (userDict.containsKey(word)) return
        val cand = findBengaliEdit1(word, dictSet) ?: return
        ic.deleteSurroundingText(word.length, 0)
        ic.commitText(cand, 1)
        autoCorrectOriginal = word
        autoCorrectTime = System.currentTimeMillis()
        autoCorrectLen = cand.length
    }

    private fun findBengaliEdit1(word: String, dictSet: Set<String>): String? {
        val matra = mapOf(
            '\u09BF' to '\u09C0', '\u09C0' to '\u09BF',
            '\u09C1' to '\u09C2', '\u09C2' to '\u09C1',
            '\u09C7' to '\u09C8', '\u09C8' to '\u09C7',
            '\u09CB' to '\u09CC', '\u09CC' to '\u09CB',
            '\u0985' to '\u0986', '\u0986' to '\u0985'
        )
        for (i in word.indices) {
            val alt = matra[word[i]] ?: continue
            val cand = word.substring(0, i) + alt + word.substring(i + 1)
            if (cand in dictSet) return cand
        }
        val cons = mapOf(
            '\u09A8' to '\u09A3', '\u09A3' to '\u09A8',
            '\u09B6' to '\u09B7', '\u09B7' to '\u09B6',
            '\u09B8' to '\u09B6', '\u09B6' to '\u09B8',
            '\u09AC' to '\u09AD', '\u09AD' to '\u09AC',
            '\u09A1' to '\u09DC', '\u09DC' to '\u09A1',
            '\u09A2' to '\u09DD', '\u09DD' to '\u09A2',
            '\u099C' to '\u09AF', '\u09AF' to '\u099C',
            '\u09AB' to '\u09AA', '\u09AA' to '\u09AB'
        )
        for (i in word.indices) {
            val alt = cons[word[i]] ?: continue
            val cand = word.substring(0, i) + alt + word.substring(i + 1)
            if (cand in dictSet) return cand
        }
        if (word.length >= 3) {
            for (i in word.indices) {
                val cand = word.substring(0, i) + word.substring(i + 1)
                if (cand in dictSet) return cand
            }
        }
        return null
    }

    private fun learnCurrentBengaliWord() {
        val ic = currentInputConnection ?: return
        val before = ic.getTextBeforeCursor(40, 0)?.toString() ?: return
        val trimmed = before.trimEnd().trimEnd('\u0964')
        if (trimmed.isEmpty()) return
        val sb = StringBuilder()
        for (i in trimmed.length - 1 downTo 0) {
            val c = trimmed[i]
            if (isBengaliLetter(c)) sb.insert(0, c) else break
        }
        val w = sb.toString()
        if (w.length >= 2) learnWord(w)
    }

    // ─── User learning ─────────────────────────────────────
    private fun learnWord(word: String) {
        val w = word.trim()
        if (w.length < 2 || w.length > 25) return
        if (!w.all { it.isLetter() || it == '\'' }) return
        val key = w.lowercase()
        userDict[key] = (userDict[key] ?: 0) + 1
        if (userDict.size > 500) {
            userDict.entries.sortedBy { it.value }.take(userDict.size - 500)
                .forEach { userDict.remove(it.key) }
        }
        try {
            val entries = userDict.entries.sortedByDescending { it.value }
                .joinToString("|") { "${it.key}:${it.value}" }
            prefs.edit().putString("user_dict", entries).apply()
        } catch (_: Throwable) {}
    }

    // ─── Clipboard ─────────────────────────────────────────
    private fun registerClipListener() {
        if (clipListenerRegistered) return
        try {
            val cm = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
            cm.addPrimaryClipChangedListener(clipChangeListener)
            clipListenerRegistered = true
        } catch (_: Throwable) {}
    }

    private fun unregisterClipListener() {
        if (!clipListenerRegistered) return
        try {
            val cm = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
            cm.removePrimaryClipChangedListener(clipChangeListener)
        } catch (_: Throwable) {}
        clipListenerRegistered = false
    }

    private val clipChangeListener = ClipboardManager.OnPrimaryClipChangedListener {
        onSystemClipboardChanged()
    }

    private fun onSystemClipboardChanged() {
        val cm = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
        val clip = cm.primaryClip ?: return
        if (clip.itemCount == 0) return
        val txt = clip.getItemAt(0).coerceToText(this).toString().trim()
        if (txt.isEmpty() || txt in clipPinned) return
        clipRecent.remove(txt)
        clipRecent.add(0, txt)
        while (clipRecent.size > 30) clipRecent.removeAt(clipRecent.size - 1)
        saveClipboard()
        if (activePanel == "clipboard") showClipboardPanel()
    }

    private fun saveClipboard() {
        try {
            prefs.edit()
                .putString("clip_recent", clipRecent.joinToString("\u0001"))
                .putString("clip_pinned", clipPinned.joinToString("\u0001"))
                .apply()
        } catch (_: Throwable) {}
    }

    private fun syncSystemClipboard() {
        val cm = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
        val clip = cm.primaryClip ?: return
        if (clip.itemCount == 0) return
        val txt = clip.getItemAt(0).coerceToText(this).toString().trim()
        if (txt.isEmpty() || txt in clipPinned) return
        clipRecent.remove(txt)
        clipRecent.add(0, txt)
        while (clipRecent.size > 30) clipRecent.removeAt(clipRecent.size - 1)
    }

    private fun showClipboardPanel() {
        activePanel = "clipboard"
        contentContainer.removeAllViews()

        val header = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            setPadding(dpToPx(8), dpToPx(8), dpToPx(8), dpToPx(6))
            gravity = Gravity.CENTER_VERTICAL
        }
        header.addView(iconButton(R.drawable.ic_keyboard) { showKeys() })
        header.addView(TextView(this).apply {
            text = "Clipboard"
            setTextColor(fgText)
            textSize = 15f
            setTypeface(null, Typeface.BOLD)
            setPadding(dpToPx(12), 0, 0, 0)
            layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
        })
        header.addView(iconButton(R.drawable.ic_trash) {
            clipRecent.clear()
            clipPinned.clear()
            saveClipboard()
            showClipboardPanel()
        })
        contentContainer.addView(header)

        syncSystemClipboard()

        if (clipRecent.isEmpty() && clipPinned.isEmpty()) {
            contentContainer.addView(TextView(this).apply {
                text = "No clipboard items yet.\nCopy text and it will appear here."
                setTextColor(fgMuted)
                textSize = 13f
                gravity = Gravity.CENTER
                setPadding(dpToPx(24), dpToPx(50), dpToPx(24), dpToPx(30))
            })
        } else {
            val scroll = ScrollView(this)
            val body = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }

            if (clipRecent.isNotEmpty()) {
                body.addView(sectionHeader("Recent"))
                val row = LinearLayout(this).apply {
                    orientation = LinearLayout.HORIZONTAL
                    setPadding(dpToPx(6), 0, dpToPx(6), dpToPx(8))
                }
                clipRecent.forEach { row.addView(clipboardCard(it, false)) }
                val hs = HorizontalScrollView(this).apply {
                    isHorizontalScrollBarEnabled = false
                    addView(row)
                }
                body.addView(hs)
            }

            if (clipPinned.isNotEmpty()) {
                body.addView(sectionHeader("Pinned"))
                val row = LinearLayout(this).apply {
                    orientation = LinearLayout.HORIZONTAL
                    setPadding(dpToPx(6), 0, dpToPx(6), dpToPx(8))
                }
                clipPinned.forEach { row.addView(clipboardCard(it, true)) }
                val hs = HorizontalScrollView(this).apply {
                    isHorizontalScrollBarEnabled = false
                    addView(row)
                }
                body.addView(hs)
            }

            val bottom = LinearLayout(this).apply {
                orientation = LinearLayout.HORIZONTAL
                setPadding(dpToPx(8), dpToPx(6), dpToPx(8), dpToPx(4))
            }
            bottom.addView(actionBtn("Paste from clipboard") {
                val cm = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
                val clip = cm.primaryClip
                if (clip != null && clip.itemCount > 0) {
                    val txt = clip.getItemAt(0).coerceToText(this).toString()
                    if (txt.isNotEmpty()) {
                        clipRecent.remove(txt)
                        clipRecent.add(0, txt)
                        saveClipboard()
                        currentInputConnection?.commitText(txt, 1)
                        showClipboardPanel()
                    }
                }
            })
            body.addView(bottom)

            scroll.addView(body)
            scroll.layoutParams = LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT
            )
            contentContainer.addView(scroll)
        }
    }

    private fun sectionHeader(title: String): View = LinearLayout(this).apply {
        orientation = LinearLayout.HORIZONTAL
        setPadding(dpToPx(12), dpToPx(10), dpToPx(12), dpToPx(4))
        addView(TextView(this@MeeKeyboardService).apply {
            text = title
            setTextColor(fgBrand)
            textSize = 12f
            setTypeface(null, Typeface.BOLD)
            layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
        })
    }

    private fun iconButton(iconRes: Int, onClick: () -> Unit): View = ImageView(this).apply {
        setImageResource(iconRes)
        setColorFilter(fgText)
        val size = dpToPx(36)
        layoutParams = LinearLayout.LayoutParams(size, size)
        setPadding(dpToPx(8), dpToPx(8), dpToPx(8), dpToPx(8))
        setOnClickListener { v -> haptic(v); onClick() }
    }

    private fun clipboardCard(text: String, pinned: Boolean): View {
        val preview = if (text.length > 60) text.substring(0, 60).trim() + "\u2026" else text
        return LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setBackgroundColor(bgItem)
            layoutParams = LinearLayout.LayoutParams(dpToPx(150), dpToPx(70)).apply {
                val m = dpToPx(4)
                setMargins(m, m, m, m)
            }
            setPadding(dpToPx(10), dpToPx(8), dpToPx(10), dpToPx(8))
            addView(TextView(this@MeeKeyboardService).apply {
                this.text = preview
                setTextColor(fgText)
                textSize = 12f
                maxLines = 3
                ellipsize = TextUtils.TruncateAt.END
                layoutParams = LinearLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f
                )
            })
            setOnClickListener { v ->
                haptic(v)
                currentInputConnection?.commitText(text, 1)
            }
            setOnLongClickListener { v ->
                haptic(v)
                showCardMenu(text, pinned, v)
                true
            }
        }
    }

    private fun showCardMenu(text: String, pinned: Boolean, anchor: View) {
        val menu = android.widget.PopupMenu(this, anchor)
        menu.menu.add(0, 1, 0, if (pinned) "Unpin" else "Pin")
        menu.menu.add(0, 2, 1, "Delete")
        menu.setOnMenuItemClickListener { item ->
            when (item.itemId) {
                1 -> {
                    if (pinned) { clipPinned.remove(text); clipRecent.add(0, text) }
                    else { clipRecent.remove(text); clipPinned.add(0, text) }
                    saveClipboard(); showClipboardPanel(); true
                }
                2 -> {
                    clipRecent.remove(text); clipPinned.remove(text)
                    saveClipboard(); showClipboardPanel(); true
                }
                else -> false
            }
        }
        menu.show()
    }

    // ─── Emoji panel ───────────────────────────────────────
    private fun showEmojiPanel() {
        activePanel = "emoji"
        contentContainer.removeAllViews()

        val tabs = HorizontalScrollView(this).apply {
            isHorizontalScrollBarEnabled = false
            setBackgroundColor(bgToolbar)
        }
        val tabsRow = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            setPadding(dpToPx(4), dpToPx(4), dpToPx(4), dpToPx(4))
        }
        EMOJI_CATS.forEach { cat -> tabsRow.addView(emojiTab(cat)) }
        tabs.addView(tabsRow)
        contentContainer.addView(tabs)

        val scroll = ScrollView(this).apply {
            layoutParams = LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f
            )
        }
        val body = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(dpToPx(2), dpToPx(6), dpToPx(2), dpToPx(6))
        }

        if (emojiRecent.isNotEmpty()) {
            body.addView(sectionHeader("Recent"))
            body.addView(buildEmojiRows(emojiRecent))
        }
        val list = EMOJIS[emojiCategory] ?: emptyList()
        body.addView(buildEmojiRows(list))

        scroll.addView(body)
        contentContainer.addView(scroll)

        val bottom = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            setPadding(dpToPx(6), dpToPx(4), dpToPx(6), dpToPx(4))
        }
        bottom.addView(actionBtn("Back to keys") { showKeys() })
        bottom.addView(actionBtn("Delete") {
            currentInputConnection?.deleteSurroundingText(1, 0)
        })
        contentContainer.addView(bottom)
    }

    private fun emojiTab(cat: String): View {
        val active = cat == emojiCategory
        return TextView(this).apply {
            text = cat
            textSize = 12f
            setTextColor(if (active) Color.WHITE else fgMuted)
            setBackgroundColor(if (active) Color.parseColor("#2563EB") else Color.TRANSPARENT)
            setPadding(dpToPx(10), dpToPx(6), dpToPx(10), dpToPx(6))
            layoutParams = LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT
            ).apply {
                val m = dpToPx(2)
                setMargins(m, m, m, m)
            }
            setOnClickListener { v ->
                haptic(v)
                emojiCategory = cat
                showEmojiPanel()
            }
        }
    }

    private fun buildEmojiRows(emojis: List<String>): View {
        val wrapper = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }
        val perRow = 8
        var i = 0
        while (i < emojis.size) {
            val rowView = row()
            var count = 0
            while (i < emojis.size && count < perRow) {
                rowView.addView(emojiKey(emojis[i]))
                i++
                count++
            }
            while (count < perRow) {
                rowView.addView(View(this).apply { layoutParams = baseParams(1f) })
                count++
            }
            wrapper.addView(rowView)
        }
        return wrapper
    }

    private fun emojiKey(emoji: String): Button = Button(this).apply {
        text = emoji
        textSize = 20f
        setTextColor(fgText)
        setBackgroundResource(keyBgRes())
        setPadding(0, 0, 0, 0)
        stateListAnimator = null
        isAllCaps = false
        layoutParams = baseParams(1f)
        setOnClickListener { v ->
            haptic(v)
            currentInputConnection?.commitText(emoji, 1)
            emojiRecent.remove(emoji)
            emojiRecent.add(0, emoji)
            while (emojiRecent.size > 24) emojiRecent.removeAt(emojiRecent.size - 1)
        }
    }

    // ─── Theme panel ───────────────────────────────────────
    private fun showThemePanel() {
        activePanel = "theme"
        contentContainer.removeAllViews()
        contentContainer.addView(TextView(this).apply {
            text = "Theme"
            setTextColor(fgBrand)
            textSize = 14f
            setTypeface(null, Typeface.BOLD)
            setPadding(dpToPx(16), dpToPx(10), dpToPx(16), dpToPx(10))
        })
        contentContainer.addView(themeRow("Dark", "dark"))
        contentContainer.addView(themeRow("Light", "light"))
        contentContainer.addView(themeRow("Blue", "blue"))
        val back = row()
        back.addView(actionBtn("Back to keys") { showKeys() })
        contentContainer.addView(back)
    }

    private fun themeRow(label: String, key: String): View {
        val active = theme == key
        return LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            setPadding(dpToPx(16), dpToPx(14), dpToPx(16), dpToPx(14))
            gravity = Gravity.CENTER_VERTICAL
            isClickable = true
            if (active) setBackgroundColor(bgKey)
            addView(TextView(this@MeeKeyboardService).apply {
                text = label
                setTextColor(fgText)
                textSize = 14f
                layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
            })
            if (active) {
                addView(TextView(this@MeeKeyboardService).apply {
                    text = "\u2713"
                    setTextColor(fgBrand)
                    textSize = 16f
                })
            }
            setOnClickListener { v ->
                haptic(v)
                theme = key
                try { prefs.edit().putString("theme", key).apply() } catch (_: Throwable) {}
                showThemePanel()
            }
        }
    }

    // ─── Settings panel ────────────────────────────────────
    private fun showSettingsPanel() {
        activePanel = "settings"
        contentContainer.removeAllViews()

        contentContainer.addView(TextView(this).apply {
            text = "Settings"
            setTextColor(fgBrand)
            textSize = 14f
            setTypeface(null, Typeface.BOLD)
            setPadding(dpToPx(16), dpToPx(10), dpToPx(16), dpToPx(10))
        })

        contentContainer.addView(settingRow("Sound on tap", soundOn) {
            soundOn = !soundOn
            try { prefs.edit().putBoolean("sound_on", soundOn).apply() } catch (_: Throwable) {}
            showSettingsPanel()
        })

        contentContainer.addView(settingRow("Bengali layout", language == "bn") {
            toggleLang()
            showSettingsPanel()
        })

        contentContainer.addView(actionBtn("Clear user dictionary (${userDict.size} words)") {
            userDict.clear()
            try { prefs.edit().putString("user_dict", "").apply() } catch (_: Throwable) {}
            showSettingsPanel()
        })

        contentContainer.addView(TextView(this).apply {
            text = "Background"
            setTextColor(fgBrand)
            textSize = 13f
            setTypeface(null, Typeface.BOLD)
            setPadding(dpToPx(16), dpToPx(16), dpToPx(16), dpToPx(6))
        })

        val bgRow = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            setPadding(dpToPx(10), dpToPx(4), dpToPx(10), dpToPx(8))
        }
        listOf("night", "blue", "sunset", "forest", "pink", "grey").forEach {
            bgRow.addView(bgSwatch(it))
        }
        contentContainer.addView(bgRow)

        val bgActions = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            setPadding(dpToPx(10), dpToPx(4), dpToPx(10), dpToPx(4))
        }
        bgActions.addView(actionBtn("Pick from gallery") {
            try {
                val i = android.content.Intent(this, ImagePickerActivity::class.java)
                i.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK)
                startActivity(i)
            } catch (_: Throwable) {}
        })
        bgActions.addView(actionBtn("Reset") {
            background = "none"
            try { prefs.edit().putString("background", "none").apply() } catch (_: Throwable) {}
            showSettingsPanel()
        })
        contentContainer.addView(bgActions)

        val back = row()
        back.addView(actionBtn("Back to keys") { showKeys() })
        contentContainer.addView(back)
    }

    private fun settingRow(title: String, value: Boolean, onToggle: () -> Unit): View =
        LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            setPadding(dpToPx(16), dpToPx(14), dpToPx(16), dpToPx(14))
            gravity = Gravity.CENTER_VERTICAL
            isClickable = true
            addView(TextView(this@MeeKeyboardService).apply {
                text = title
                setTextColor(fgText)
                textSize = 14f
                layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f)
            })
            addView(Switch(this@MeeKeyboardService).apply {
                isChecked = value
                isClickable = false
            })
            setOnClickListener { v -> haptic(v); onToggle() }
        }

    private fun bgSwatch(preset: String): View {
        val active = background == "preset_$preset" ||
                     (preset == "night" && background == "none")
        val color = when (preset) {
            "blue" -> Color.parseColor("#1E3A8A")
            "sunset" -> Color.parseColor("#7C2D12")
            "forest" -> Color.parseColor("#14532D")
            "pink" -> Color.parseColor("#831843")
            "grey" -> Color.parseColor("#374151")
            else -> Color.parseColor("#0F172A")
        }
        return View(this).apply {
            layoutParams = LinearLayout.LayoutParams(dpToPx(48), dpToPx(48)).apply {
                val m = dpToPx(3)
                setMargins(m, m, m, m)
            }
            background = GradientDrawable().apply {
                shape = GradientDrawable.OVAL
                setColor(color)
                if (active) setStroke(dpToPx(3), Color.parseColor("#60A5FA"))
                else setStroke(dpToPx(1), Color.parseColor("#334155"))
            }
            setOnClickListener { v ->
                haptic(v)
                this@MeeKeyboardService.background = if (preset == "night") "none" else "preset_$preset"
                try {
                    prefs.edit().putString("background", this@MeeKeyboardService.background).apply()
                } catch (_: Throwable) {}
                showSettingsPanel()
            }
        }
    }

    // ─── Swipe typing ──────────────────────────────────────
    private fun processSwipePath(path: List<Pair<Float, Float>>) {
        if (language != "en") return
        val visited = mutableListOf<Char>()
        val step = maxOf(1, path.size / 40)
        var i = 0
        while (i < path.size) {
            val (x, y) = path[i]
            val btn = contentContainer.keyUnder(x, y)
            val ch = btn?.text?.toString()?.firstOrNull()
            if (ch != null && ch.isLetter()) {
                if (visited.isEmpty() || visited.last() != ch) visited.add(ch)
            }
            i += step
        }
        if (visited.size < 2) return
        val swiped = visited.joinToString("").lowercase()
        val best = findSwipeMatch(swiped) ?: return
        commit("$best ")
        learnWord(best)
        applyAutoCapitalize()
        refreshSuggestionBar()
    }

    private fun findSwipeMatch(swiped: String): String? {
        val dict = EN_WORDS ?: return null
        if (dict.isEmpty()) return null
        var best: String? = null
        var bestScore = 0.0
        for (w in dict) {
            if (w.length < 3) continue
            if (w.length < swiped.length - 3 || w.length > swiped.length + 3) continue
            val score = lcsRatio(swiped, w)
            if (score > bestScore) { bestScore = score; best = w }
        }
        return if (bestScore >= 0.6) best else null
    }

    private fun lcsRatio(a: String, b: String): Double {
        if (a.isEmpty() || b.isEmpty()) return 0.0
        val n = a.length
        val m = b.length
        val dp = Array(n + 1) { IntArray(m + 1) }
        for (i in 1..n) for (j in 1..m) {
            dp[i][j] = if (a[i - 1] == b[j - 1]) dp[i - 1][j - 1] + 1
                      else maxOf(dp[i - 1][j], dp[i][j - 1])
        }
        return dp[n][m].toDouble() / maxOf(n, m)
    }

    // ─── Background ────────────────────────────────────────
    private fun applyBackground(view: View) {
        val bg = background
        when {
            bg == "custom" -> {
                try {
                    val path = prefs.getString("custom_bg_path", null)
                    if (!path.isNullOrEmpty()) {
                        val f = File(path)
                        if (f.exists()) {
                            val d = Drawable.createFromPath(f.absolutePath)
                            if (d != null) { view.background = d; return }
                        }
                    }
                } catch (_: Throwable) {}
                view.setBackgroundColor(bgDark)
            }
            bg.startsWith("preset_") -> {
                val gd = presetDrawable(bg.removePrefix("preset_"))
                if (gd != null) view.background = gd else view.setBackgroundColor(bgDark)
            }
            else -> view.setBackgroundColor(bgDark)
        }
    }

    private fun presetDrawable(presetName: String): Drawable? = when (presetName) {
        "blue" -> GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
            intArrayOf(Color.parseColor("#1E3A8A"), Color.parseColor("#0B1220")))
        "sunset" -> GradientDrawable(GradientDrawable.Orientation.TL_BR,
            intArrayOf(Color.parseColor("#7C2D12"), Color.parseColor("#3B0764")))
        "forest" -> GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
            intArrayOf(Color.parseColor("#14532D"), Color.parseColor("#052E16")))
        "pink" -> GradientDrawable(GradientDrawable.Orientation.TL_BR,
            intArrayOf(Color.parseColor("#831843"), Color.parseColor("#4C0519")))
        "grey" -> GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
            intArrayOf(Color.parseColor("#374151"), Color.parseColor("#111827")))
        else -> null
    }

    // ─── Helpers ───────────────────────────────────────────
    private fun dpToPx(dp: Int): Int = (dp * resources.displayMetrics.density).toInt()

    private fun row(): LinearLayout = LinearLayout(this).apply {
        orientation = LinearLayout.HORIZONTAL
    }

    private fun baseParams(weight: Float): LinearLayout.LayoutParams =
        LinearLayout.LayoutParams(0, dpToPx(44), weight).apply {
            val m = dpToPx(3)
            setMargins(m, m, m, m)
        }

    private fun haptic(v: View) {
        v.performHapticFeedback(
            HapticFeedbackConstants.KEYBOARD_TAP,
            HapticFeedbackConstants.FLAG_IGNORE_GLOBAL_SETTING
        )
    }

    private fun actionBtn(label: String, onClick: () -> Unit): Button = Button(this).apply {
        text = label
        textSize = 13f
        setTextColor(fgText)
        setBackgroundResource(keySpecialRes())
        setPadding(0, 0, 0, 0)
        isAllCaps = false
        stateListAnimator = null
        val lp = LinearLayout.LayoutParams(0, dpToPx(44), 1f)
        val m = dpToPx(3)
        lp.setMargins(m, m, m, m)
        layoutParams = lp
        setOnClickListener { v -> haptic(v); onClick() }
    }

    private fun startBackspaceRepeat() {
        stopBackspaceRepeat()
        val r = object : Runnable {
            override fun run() {
                currentInputConnection?.deleteSurroundingText(1, 0)
                handler.postDelayed(this, 60L)
            }
        }
        backspaceRepeat = r
        handler.postDelayed(r, 250L)
    }

    private fun stopBackspaceRepeat() {
        backspaceRepeat?.let { handler.removeCallbacks(it) }
        backspaceRepeat = null
    }

    private fun updateEnterLabel(info: EditorInfo?) {
        enterLabel = when (info?.imeOptions?.and(EditorInfo.IME_MASK_ACTION)) {
            EditorInfo.IME_ACTION_SEARCH -> "Search"
            EditorInfo.IME_ACTION_SEND -> "Send"
            EditorInfo.IME_ACTION_NEXT -> "Next"
            EditorInfo.IME_ACTION_DONE -> "Done"
            EditorInfo.IME_ACTION_GO -> "Go"
            else -> "\u23CE"
        }
    }

    private fun commit(text: String) {
        currentInputConnection?.commitText(text, 1)
    }
}
